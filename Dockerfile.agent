# reins Agent Dockerfile(multi-stage,用于 Linux 容器化部署)
#
# 注意: Agent 通常部署到 Windows 主机(作为服务运行)。
# 此 Dockerfile 用于 Linux 场景(CI/测试/容器化内网穿透)。
# Windows 部署用 bin/reins-agent.exe + install 命令。
#
# 构建: docker build -f Dockerfile.agent -t reins-agent:latest .
# 运行: docker run -d --name rmm-agent reins-agent:latest -relay ws://relay:7780/agent

FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags "-s -w -X main.version=$(git describe --tags --always --dirty 2>/dev/null || echo docker)" \
    -o /out/reins-agent ./agent/

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -u 1000 rmm

WORKDIR /app
COPY --from=builder /out/reins-agent /app/reins-agent

RUN mkdir -p /data /app/workspace && chown -R rmm:rmm /data /app/workspace
VOLUME ["/data", "/app/workspace"]

USER rmm

ENTRYPOINT ["/app/reins-agent"]
CMD ["run", "-relay", "ws://relay:7780/agent"]
