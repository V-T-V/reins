# go-rmm Relay systemd 服务模板
#
# 安装:
#   sudo cp deploy/go-rmm-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable go-rmm-relay
#   sudo systemctl start go-rmm-relay
#
# 日志: journalctl -u go-rmm-relay -f

[Unit]
Description=go-rmm Relay Server (远程自动化中继)
Documentation=https://github.com/QiuShichang/go-rmm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rmm
Group=rmm

# 二进制路径(按实际安装位置修改)
ExecStart=/opt/go-rmm/go-rmm-relay -addr :7780

# 数据目录
WorkingDirectory=/opt/go-rmm
Environment="GO_RMM_RELAY_DATA_DIR=/opt/go-rmm/data"

# 自动重启 + 限制
Restart=always
RestartSec=3
LimitNOFILE=65536

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/go-rmm/data
PrivateTmp=true

# 日志到 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=go-rmm-relay

[Install]
WantedBy=multi-user.target
